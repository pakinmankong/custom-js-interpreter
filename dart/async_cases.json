[
  {
    "name": "async service object is ready before property access",
    "code": "var row=FIND_STD_ERROR(1,5);return row.uncertainty;",
    "expected": 10
  },
  {
    "name": "async result in binary and unary expressions",
    "code": "return [DOUBLE(3)+DOUBLE(4),-DOUBLE(2),!DOUBLE(0),DOUBLE(3)>5];",
    "expected": [
      14,
      -4,
      true,
      true
    ]
  },
  {
    "name": "short circuit and conditional await only selected branches",
    "code": "return [false&&FAIL(),true||FAIL(),null??DOUBLE(3),DOUBLE(1)?DOUBLE(4):FAIL()];",
    "expected": [
      false,
      true,
      6,
      8
    ]
  },
  {
    "name": "if else awaits test and body",
    "code": "if(DOUBLE(1)===2){return DOUBLE(3);}else{return FAIL();}",
    "expected": 6
  },
  {
    "name": "for loop awaits body update break and continue",
    "code": "var total=0;for(var i=0;i<DOUBLE(4);i++){if(i===1){continue;}if(i===4){break;}total+=DOUBLE(i);}return total;",
    "expected": 10
  },
  {
    "name": "while and do while await tests and assignments",
    "code": "var x=0;while(x<DOUBLE(2)){x+=DOUBLE(1);}do{x--;}while(x>DOUBLE(1));return x;",
    "expected": 2
  },
  {
    "name": "for of and for in await values and body",
    "code": "var sum=0;for(const n of [DOUBLE(1),DOUBLE(2)]){sum+=n;}for(var key in {a:DOUBLE(3)}){sum+=DOUBLE(1);}return sum;",
    "expected": 8
  },
  {
    "name": "nested functions closures default rest and explicit returns",
    "code": "function f(a=DOUBLE(2),...rest){return ()=>DOUBLE(a+rest[0]);}return f(void 0,3)();",
    "expected": 14
  },
  {
    "name": "array map awaits every callback and captures index",
    "code": "return [1,2,3].map((n,i)=>DOUBLE(n)+i);",
    "expected": [
      2,
      5,
      8
    ]
  },
  {
    "name": "array filter some every find and findIndex await predicates",
    "code": "const a=[1,2,3];return [a.filter(n=>DOUBLE(n)>2),a.some(n=>DOUBLE(n)===4),a.every(n=>DOUBLE(n)>0),a.find(n=>DOUBLE(n)>2),a.findIndex(n=>DOUBLE(n)>2)];",
    "expected": [
      [
        2,
        3
      ],
      true,
      true,
      2,
      1
    ]
  },
  {
    "name": "array reduce awaits accumulator and callback",
    "code": "return [1,2,3].reduce((sum,n)=>sum+DOUBLE(n),0);",
    "expected": 12
  },
  {
    "name": "array sort awaits comparator",
    "code": "return [3,1,2].sort((a,b)=>COMPARE(a,b));",
