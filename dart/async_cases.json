      1,
      2,
      3
    ]
  },
  {
    "name": "forEach awaits side effects in order",
    "code": "var sum=0;[1,2,3].forEach(n=>{sum+=DOUBLE(n);});return sum;",
    "expected": 12
  },
  {
    "name": "computed member assignments and object spread await inputs",
    "code": "var obj={...{x:DOUBLE(1)},[\"y\"]:DOUBLE(2)};obj[\"x\"]+=DOUBLE(3);return obj; ",
    "expected": {
      "x": 8,
      "y": 4
    }
  },
  {
    "name": "array spread call spread and nested arrays await inputs",
