{
  "name": "custom-js-interpreter",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test testing.ts",
    "test:package": "npm run build && node --test tests/package.test.mjs",
    "test:parity": "tsx tools/check_parity.ts",
    "example": "tsx index.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:package",
    "benchmark:ast-cache": "npm run build && tsx tools/benchmark_ast_cache.ts",
    "export:ast": "tsx tools/export_ast_cache.ts",
    "test:ast-json": "tsx tools/check_parity.ts --ast-json"
  },
  "keywords": [
    "javascript",
    "interpreter",
    "formula",
    "ast",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "description": "A custom JavaScript AST interpreter with formula resolution and extensible functions.",
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "jstat": "^1.9.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "FUNCTIONS.md",
    "PARITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinkop/js-custom-interpreter.git"
  },
  "bugs": {
    "url": "https://github.com/kinkop/js-custom-interpreter/issues"
  },
  "homepage": "https://github.com/kinkop/js-custom-interpreter#readme"
}
